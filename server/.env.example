# PostgreSQL connection string used by Prisma and the Express API
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/team_task_manager?schema=public"

# Use a long random secret in real environments
JWT_SECRET="replace-with-a-long-random-jwt-secret"

# Railway provides PORT automatically in production
PORT=5000

# Comma-separated origins are supported, for example:
# FRONTEND_URL="http://localhost:5173,https://your-railway-app.up.railway.app"
FRONTEND_URL="http://localhost:5173"
